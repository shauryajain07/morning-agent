{
  "name": "morning-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "morning": "node --env-file=.env --import=tsx src/index.ts",
    "gmail:login": "node --env-file=.env --import=tsx src/gmailLogin.ts",
    "dashboard": "npm run dashboard:build && node --env-file=.env --import=tsx src/dashboard/server.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "dashboard:typecheck": "tsc --noEmit -p tsconfig.dashboard.json",
    "test": "vitest run",
    "recall": "node --import=tsx scripts/recall.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "playwright": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^3.1.3"
  }
}

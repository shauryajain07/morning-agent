# Required for live TypeSafe Jev decisions.
TYPESAFE_API_KEY=

# Optional read-only Gmail API collection for the previous 24 hours.
# Gmail private-mailbox access uses OAuth 2.0 with gmail.readonly; an API key alone is not enough.
GMAIL_ENABLED=false
GMAIL_ACCESS_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Or point at standard Google OAuth JSON files instead.
GMAIL_CREDENTIALS_PATH=.gmail-credentials.json
GMAIL_TOKEN_PATH=.gmail-token.json
GMAIL_USER_ID=me
# Leave empty for all mail matching the 24-hour window; use e.g. "is:unread newer_than:1d" if desired.
GMAIL_QUERY=
GMAIL_LOOKBACK_HOURS=24
GMAIL_MAX_MESSAGES=500
GMAIL_TIMEOUT_MS=15000
GMAIL_INCLUDE_SPAM_TRASH=false

# Optional read-only Moodle collection. Set the base URL to your Moodle dashboard.
# The first headed run opens Chromium so you can log in manually; credentials and MFA are never automated.
MOODLE_ENABLED=false
MOODLE_BASE_URL=
MOODLE_BROWSER_PROFILE=.browser-profile
# Alternatively attach to an already-running Chromium launched with remote debugging enabled.
MOODLE_CDP_URL=
MOODLE_HEADLESS=false
MOODLE_TIMEOUT_MS=15000
MOODLE_LOGIN_TIMEOUT_MS=300000
MOODLE_MAX_COURSE_PAGES=12
MOODLE_MAX_DETAIL_PAGES=40

# Optional read-only Outlook Web collection. Set this true to include the previous
# 24 hours of inbox mail in the same Jev email briefing.
OUTLOOK_ENABLED=false
OUTLOOK_BASE_URL=https://outlook.office.com/mail/
OUTLOOK_BROWSER_PROFILE=.outlook-browser-profile
# Alternatively attach to an already-running Chromium session over CDP.
OUTLOOK_CDP_URL=
OUTLOOK_HEADLESS=false
OUTLOOK_TIMEOUT_MS=15000
OUTLOOK_LOGIN_TIMEOUT_MS=300000
OUTLOOK_LOOKBACK_HOURS=24
OUTLOOK_MAX_SCROLLS=6

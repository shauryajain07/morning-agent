# Required for live TypeSafe Jev decisions.
TYPESAFE_API_KEY=

# Optional read-only Moodle collection. Set the base URL to your Moodle dashboard.
# The first headed run opens Chromium so you can log in manually; credentials and MFA are never automated.
MOODLE_ENABLED=false
MOODLE_BASE_URL=
MOODLE_BROWSER_PROFILE=.browser-profile
# Alternatively attach to an already-running Chromium launched with remote debugging enabled.
MOODLE_CDP_URL=
MOODLE_HEADLESS=false
MOODLE_TIMEOUT_MS=15000
MOODLE_LOGIN_TIMEOUT_MS=300000
MOODLE_MAX_COURSE_PAGES=12
MOODLE_MAX_DETAIL_PAGES=40
